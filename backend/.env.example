# PAM backend — semua variabel dengan default aman.
# Salin ke `.env`, lalu isi hanya yang bertanda WAJIB-ISI untuk produksi.
# `npm start` tanpa .env tetap jalan: SQLite lokal + provider LLM palsu.
# Catatan: komentar harus di baris sendiri (bukan di belakang nilai).

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=8080
# Path file SQLite. Pakai `:memory:` untuk uji cepat tanpa menyentuh disk.
DATABASE_PATH=./data/pam.db
# debug | info | warn | error
LOG_LEVEL=info

# --- Google ID token (FR-01, FR-05) ---------------------------------------
# WAJIB-ISI untuk produksi: client ID Web (D2 di docs/05_REAL_GOOGLE_SETUP.md).
# Nilai ini juga menjadi `aud` yang diverifikasi backend (contract §2.1).
GOOGLE_WEB_CLIENT_ID=dev-client-id.apps.googleusercontent.com
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# Development saja: token "dev:<sub>:<nama>" diterima tanpa Google.
# Produksi menolak nilai true.
AUTH_DEV_FAKE_TOKENS=true

# WAJIB-ISI (produksi): `openssl rand -hex 32`. Dipakai untuk hash token sesi.
SESSION_PEPPER=
SESSION_TTL_DAYS=30

# WAJIB-ISI (produksi): `openssl rand -base64 32` — 32 byte untuk AES-256-GCM.
# Simpan terpisah dari file DB (contract §6).
DATA_ENCRYPTION_KEY=
DATA_KEY_VERSION=1

# --- LLM (OI-07) -----------------------------------------------------------
# fake = deterministik, tanpa jaringan (default, dipakai semua test).
LLM_PROVIDER=fake
# OpenAI: https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.openai.com/v1
# WAJIB-ISI saat LLM_PROVIDER=openai.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_OUTPUT_TOKENS=800
LLM_TIMEOUT_MS=45000
# valid | malformed | invented | injection | invalid_then_valid
FAKE_LLM_SCENARIO=valid

# --- Batas & biaya (FR-50) -------------------------------------------------
RATE_LIMIT_ANALYSES_PER_HOUR=10
RATE_LIMIT_ANALYSES_PER_DAY=40
DAILY_AI_CEILING_USD=1.00
# USD per 1K token; default mengikuti harga gpt-4o-mini.
PRICE_PROMPT_PER_1K_USD=0.00015
PRICE_COMPLETION_PER_1K_USD=0.00060

# --- Internal --------------------------------------------------------------
# WAJIB-ISI (produksi): token untuk POST /v1/internal/sweep.
INTERNAL_SWEEP_TOKEN=
