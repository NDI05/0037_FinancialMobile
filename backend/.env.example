# PAM backend — semua variabel dengan default aman.
# Salin ke `.env`, lalu isi hanya yang bertanda WAJIB-ISI untuk produksi.
# `npm start` tanpa .env tetap jalan: SQLite lokal + provider LLM palsu.
# Catatan: komentar harus di baris sendiri (bukan di belakang nilai).

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=8080
# Path file SQLite. Pakai `:memory:` untuk uji cepat tanpa menyentuh disk.
DATABASE_PATH=./data/pam.db
# debug | info | warn | error
LOG_LEVEL=info

# --- Akun PAM (FR-51…FR-53, CR-001) --------------------------------------
# Registrasi butuh kode undangan. WAJIB-ISI (produksi), minimal 8 karakter.
# Di development, kosong = "pam-dev" (dipakai test dan smoke).
REGISTRATION_INVITE_CODE=
# Token sesi opaque; yang disimpan hanya sha256(token + pepper).
# WAJIB-ISI (produksi): `openssl rand -hex 32`.
SESSION_PEPPER=
SESSION_TTL_DAYS=30

# WAJIB-ISI (produksi): `openssl rand -base64 32` — 32 byte untuk AES-256-GCM.
# Simpan terpisah dari file DB (contract §6).
DATA_ENCRYPTION_KEY=
DATA_KEY_VERSION=1

# --- LLM (OI-07) -----------------------------------------------------------
# Default: provider palsu, deterministik, tanpa jaringan (dipakai semua test).
# Tiga preset gratis di bawah: pilih satu, komentari dua lainnya.
LLM_PROVIDER=fake

# PRESET 1 — Ollama (offline, gratis penuh, tanpa akun, tanpa API key):
#   ollama pull qwen3-vl:8b-instruct
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=http://127.0.0.1:11434/v1
#   LLM_MODEL=qwen3-vl:8b-instruct
#   LLM_API_KEY=
#
# PRESET 2 — Groq (gratis, tanpa kartu kredit; model cepat):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
#   LLM_API_KEY=<key dari console.groq.com>
#
# PRESET 3 — OpenRouter free models (nama model WAJIB berakhiran ":free"):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=<vendor>/<model>:free
#   LLM_API_KEY=<key dari openrouter.ai/keys>
LLM_BASE_URL=https://api.openai.com/v1
# Kosongkan untuk runtime lokal (Ollama/LM Studio) — tidak ada header Authorization.
# WAJIB-ISI hanya untuk penyedia remote saat NODE_ENV=production.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_OUTPUT_TOKENS=800
# Model lokal 8B bisa butuh >45 dtk untuk satu jawaban JSON.
LLM_TIMEOUT_MS=45000
# valid | malformed | invented | injection | bare_minor | invalid_then_valid
FAKE_LLM_SCENARIO=valid

# --- Batas & biaya (FR-50) -------------------------------------------------
RATE_LIMIT_ANALYSES_PER_HOUR=10
RATE_LIMIT_ANALYSES_PER_DAY=40
DAILY_AI_CEILING_USD=1.00
# USD per 1K token; default mengikuti harga gpt-4o-mini.
PRICE_PROMPT_PER_1K_USD=0.00015
PRICE_COMPLETION_PER_1K_USD=0.00060

# --- Internal --------------------------------------------------------------
# WAJIB-ISI (produksi): token untuk POST /v1/internal/sweep.
INTERNAL_SWEEP_TOKEN=
