{
  "name": "pam-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PAM backend: aggregate-only analysis, consent ledger and deletion (SRS §4.3).",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:dist": "node --env-file-if-exists=.env dist/server.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:inspect": "tsx scripts/inspect-db.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
