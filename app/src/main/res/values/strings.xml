    <!-- Consent -->
    <string name="consent_title">Persetujuan</string>
    <string name="consent_eyebrow">Sebelum mulai</string>
    <string name="consent_headline">Anda yang memutuskan apa yang dibaca PAM.</string>
    <string name="consent_intro">Dua izin di bawah diputuskan terpisah dan bisa diubah kapan saja di Pengaturan.</string>
    <string name="consent_gmail_title">Baca email notifikasi Livin</string>
    <string name="consent_gmail_body">PAM hanya mencari email dari pengirim Livin yang ada di daftar izin, lalu mengambil nominal, waktu transaksi, arah, dan nama merchant. Isi email, lampiran, dan ID pesan tidak disimpan.</string>
    <string name="consent_ai_title">Analisis dengan AI</string>
    <string name="consent_ai_body">Hanya angka agregat bulanan dan per kategori yang dikirim ke penyedia analisis. Tidak ada isi email, nama merchant, catatan pribadi, atau ID pesan. Menolak AI tidak menghilangkan ringkasan.</string>
    <string name="consent_disclosure_title">Yang keluar dari perangkat</string>
    <string name="consent_disclosure_leaves">Dikirim saat analisis: total pemasukan dan pengeluaran, total per kategori, jumlah transaksi, dan status cakupan.</string>
    <string name="consent_disclosure_stays">Tetap di perangkat: isi email, subjek, pengirim, ID pesan, nama merchant, catatan pribadi, token, dan nomor kartu.</string>
    <string name="consent_footer">Anda bisa mencabut izin AI kapan saja; laporan lama akan ditandai sebagai riwayat.</string>

